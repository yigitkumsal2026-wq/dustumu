# Bu dosyanın adını ".env" yap ve doldur (sadece bilgisayarında denemek için).
# GitHub'da bunlar Settings > Secrets and variables > Actions altına girilir. .env ASLA GitHub'a yüklenmez.

# Instagram Graph API (README > "Instagram bağlantısı")
IG_USER_ID=
IG_ACCESS_TOKEN=

# Yenilenen token'ı şifreli saklamak için rastgele uzun bir parola (örn. 40 karakter)
DURUM_ANAHTARI=

# true yaparsan config.yaml'daki instagram_aktif ayarını ezer
INSTAGRAM_AKTIF=

# İsteğe bağlı: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_KANAL=
TELEGRAM_SAHIP_ID=
